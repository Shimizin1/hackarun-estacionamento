    {
      "name": "02 - Setores",
      "item": [
        {
          "name": "GET /setores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "setores"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('6 setores', () => pm.expect(j).to.have.lengthOf(6));",
                  "pm.test('capacidade total 356', () => pm.expect(j.reduce((a, s) => a + s.capacidade_total, 0)).to.eql(356));",
                  "pm.test('livres + ocupadas = capacidade', () => j.forEach(s => pm.expect(s.vagas_livres + s.vagas_ocupadas).to.eql(s.capacidade_total)));",
                  "pm.test('campos do contrato', () => pm.expect(j[0]).to.include.all.keys('id', 'nome', 'cor', 'andar', 'bloco', 'capacidade_total', 'vagas_livres', 'vagas_ocupadas'));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Somente leitura. POST /setores e GET /setores/{id}/vagas (doc, secao 9) ficam fora do escopo da v2.0 (Won't do)."
    },
