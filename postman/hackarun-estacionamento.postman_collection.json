              "raw": "{{baseUrl}}/vagas/disponiveis?tipo=comum&setor_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vagas",
                "disponiveis"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "comum"
                },
                {
                  "key": "setor_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('um setor (Azul) filtrado', () => { pm.expect(j.por_setor).to.have.lengthOf(1); pm.expect(j.por_setor[0].setor_nome).to.eql('Azul'); });",
                  "pm.test('contadores coerentes', () => { const s = j.por_setor[0]; pm.expect(s.livres + s.ocupadas).to.eql(s.total); pm.expect(s.livres).to.eql(j.total); });",
                  "pm.test('todas as vagas sao comuns', () => j.vagas.forEach(v => pm.expect(v.tipo).to.eql('comum')));"
                ]
              }
            }
          ]
        },
